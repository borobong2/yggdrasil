# Supabase project URL, used to verify bearer tokens with Supabase Auth.
SUPABASE_URL=https://your-project.supabase.co
# Browser-safe Supabase anonymous key used only by the server's token verifier.
SUPABASE_ANON_KEY=your-anon-key
# Postgres connection string for Drizzle migrations and future owner-scoped data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yggdrasil
# Cloud Run assigns PORT; 3000 is the local default.
PORT=3000
# Optional server-only AI configuration. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
